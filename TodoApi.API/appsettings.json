{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=TodoApiDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "CHANGE_ME_USE_A_SECRET_KEY_OF_AT_LEAST_32_CHARACTERS",
    "Issuer": "TodoApi",
    "Audience": "TodoApiUsers",
    "ExpiresInMinutes": 60
  }
}